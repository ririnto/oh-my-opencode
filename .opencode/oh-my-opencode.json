{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-opencode/master/assets/oh-my-opencode.schema.json",

  "claude_code": {
    "commands": false,
    "agents": false,
    "skills": false,
    "hooks": false,
    "mcp": false,
    "plugins": false
  },

  "agents": {
    "sisyphus": {
      "model": "anthropic/claude-sonnet-4-5",
      "thinking": { "type": "enabled", "budgetTokens": 5000 },
      "maxTokens": 8192
    },
    "prometheus": {
      "model": "anthropic/claude-sonnet-4-5",
      "thinking": { "type": "enabled", "budgetTokens": 5000 },
      "maxTokens": 8192
    },
    "metis": {
      "model": "anthropic/claude-sonnet-4-5",
      "thinking": { "type": "disabled" },
      "maxTokens": 4096
    },
    "momus": {
      "model": "github-copilot/gemini-3-flash",
      "maxTokens": 4096
    },
    "librarian": {
      "model": "github-copilot/grok-code-fast-1",
      "maxTokens": 4096
    },
    "explore": {
      "model": "github-copilot/grok-code-fast-1",
      "maxTokens": 4096
    },
    "multimodal-looker": {
      "model": "github-copilot/gemini-3-flash",
      "maxTokens": 4096
    },
    "atlas": {
      "model": "github-copilot/gemini-3-flash",
      "maxTokens": 4096
    },
    "build": {
      "model": "github-copilot/grok-code-fast-1",
      "maxTokens": 4096
    },
    "plan": {
      "model": "anthropic/claude-sonnet-4-5",
      "thinking": { "type": "enabled", "budgetTokens": 3000 },
      "maxTokens": 4096
    }
  },

  "categories": {
    "ultrabrain": {
      "model": "anthropic/claude-sonnet-4-5",
      "thinking": { "type": "enabled", "budgetTokens": 5000 },
      "maxTokens": 8192
    },
    "deep": {
      "model": "anthropic/claude-sonnet-4-5",
      "thinking": { "type": "enabled", "budgetTokens": 3000 },
      "maxTokens": 4096
    },
    "unspecified-high": {
      "model": "anthropic/claude-sonnet-4-5",
      "thinking": { "type": "disabled" },
      "maxTokens": 4096
    },
    "unspecified-low": {
      "model": "github-copilot/grok-code-fast-1",
      "maxTokens": 4096
    },
    "quick": {
      "model": "github-copilot/grok-code-fast-1",
      "maxTokens": 2048
    },
    "writing": {
      "model": "github-copilot/gemini-3-flash",
      "maxTokens": 4096
    },
    "visual-engineering": {
      "model": "github-copilot/gemini-3-flash",
      "maxTokens": 4096
    },
    "artistry": {
      "model": "github-copilot/gemini-3-flash",
      "maxTokens": 4096
    }
  },

  "disabled_agents": [
    "oracle",
    "hephaestus"
  ],

  "background_task": {
    "defaultConcurrency": 2,
    "staleTimeoutMs": 120000
  },

  "sisyphus_agent": {
    "planner_enabled": true,
    "default_builder_enabled": false
  },

  "experimental": {
    "dynamic_context_pruning": {
      "enabled": true,
      "notification": "minimal"
    }
  }
}
